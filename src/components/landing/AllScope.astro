---
import { designwork } from "@/data/designwork.json";
import { devwork } from "@/data/devwork.json";
---

<section class="scroll-mt-24" id="services">
  <div class="px-8 md:px-12 py-12 max-w-2xl mx-auto">
    <div
      class="col-span-full lg:col-span-2 w-full rounded-4xl h-full items-center inline-flex text-black dark:text-white animate-fadeIn"
    >
      <h2 class="text-3xl tracking-tighter font-light">
        Research Areas
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
      <div class="p-8 bg-white dark:bg-zinc-800 rounded-3xl transition-all duration-300 animate-scaleUp animation-delay-200">
        <div class="inline-flex items-center border-b w-full border-zinc-200 dark:border-zinc-700 pb-2">
          <p class="text-2xl text-black dark:text-white">Design & Experience</p>
        </div>
        <div class="divide-y divide-zinc-100 dark:divide-zinc-700 mt-4">
          {
            designwork.map((template, index) => (
              <>
                <div 
                  class="flex flex-col sm:flex-row justify-between gap-4 lg:items-end py-2 animate-slideUp"
                  style={`animation-delay: ${300 + index * 50}ms`}
                >
                  <p class="font-medium leading-6 text-zinc-500 dark:text-zinc-400 text-sm flex gap-2 items-center hover:text-black dark:hover:text-white transition-colors duration-200">
                    ⏤
                    {template.title}
                  </p>
                </div>
              </>
            ))
          }
        </div>
      </div>
      <div class="p-8 bg-white dark:bg-zinc-800 rounded-3xl transition-all duration-300 animate-scaleUp animation-delay-300">
        <div class="inline-flex items-center border-b w-full border-zinc-200 dark:border-zinc-700 pb-2">
          <p class="text-2xl text-black dark:text-white">Technology & Engineering</p>
        </div>
        <div class="divide-y divide-zinc-100 dark:divide-zinc-700 mt-4">
          {
            devwork.map((template, index) => (
              <>
                <div 
                  class="flex flex-col sm:flex-row justify-between gap-4 lg:items-end py-2 animate-slideUp"
                  style={`animation-delay: ${400 + index * 50}ms`}
                >
                  <p class="font-medium leading-6 text-zinc-500 dark:text-zinc-400 text-sm flex gap-2 items-center hover:text-black dark:hover:text-white transition-colors duration-200">
                    ⏤
                    {template.title}
                  </p>
                </div>
              </>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes scaleUp {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .animate-scaleUp {
    opacity: 0;
    animation: scaleUp 0.5s ease-out forwards;
  }

  .animate-slideUp {
    opacity: 0;
    animation: slideUp 0.4s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  .animation-delay-300 {
    animation-delay: 300ms;
  }
</style>
