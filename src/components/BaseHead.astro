---
import "../styles/global.css";
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="ArcLabs - Research & Development in AI, Software Engineering, and Blockchain"
  description="ArcLabs is a research and development agency pushing the boundaries of technology. We build innovative products in AI, software engineering, and blockchain through independent research and strategic partnerships."
  canonical="https://arclabs.dev"
  openGraph={{
    url: "https://arclabs.dev",
    title: "ArcLabs - Research & Development in AI, Software Engineering, and Blockchain",
    description: "ArcLabs is a research and development agency pushing the boundaries of technology. We build innovative products in AI, software engineering, and blockchain through independent research and strategic partnerships.",
    images: [
      {
        url: "https://arclabs.dev/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "ArcLabs - Research & Development Agency",
        type: "image/jpeg",
      },
    ],
    site_name: "ArcLabs",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@arclabs",
    site: "@arclabs",
    cardType: "summary_large_image",
  }}
/>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>ArcLabs - Research & Development in AI, Software Engineering, and Blockchain</title>
<meta
  name="description"
  content="ArcLabs is a research and development agency pushing the boundaries of technology. We build innovative products in AI, software engineering, and blockchain through independent research and strategic partnerships."
/>
<meta name="keywords" content="research and development, R&D agency, AI research, blockchain research, software engineering, innovation, technology research, Solana, Web3, decentralized systems" />
<meta name="author" content="ArcLabs - Pratik" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

<!-- Favicons for different sizes -->
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.yourwebsite.com/" />
<meta property="og:title" content="Your Website Title" />
<meta
  property="og:description"
  content="A brief description of your website content."
/>
<meta
  property="og:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://www.yourwebsite.com/" />
<meta property="twitter:title" content="Your Website Title" />
<meta
  property="twitter:description"
  content="A brief description of your website content."
/>
<meta
  property="twitter:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://www.yourwebsite.com/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon (already included in favicons, but keeping for backwards compatibility) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#ffffff" />

<!-- For IE -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
